{
  "background": null,
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#58727b",
      "titleColor": "#47656c",
      "gridColor": "#e8eeee",
      "domain": false,
      "tickColor": "#dbe5e4",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#59757c",
      "titleColor": "#486c73"
    },
    "text": {
      "font": "DM Sans"
    },
    "range": {
      "category": [
        "#187d89",
        "#e7a078",
        "#55a6a2",
        "#9a94c5",
        "#ba728d"
      ]
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "height": 260,
  "data": {
    "url": "data/reserves.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "tick",
        "thickness": 3,
        "size": 27
      },
      "encoding": {
        "x": {
          "field": "dedication_position",
          "type": "quantitative",
          "scale": {
            "domain": [
              2005,
              2023
            ]
          },
          "axis": {
            "format": "d",
            "tickCount": 10,
            "title": "Dedication year"
          }
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "NSW",
            "WA",
            "QLD",
            "SA",
            "VIC"
          ],
          "axis": {
            "title": null
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "WA",
              "QLD",
              "SA",
              "VIC"
            ],
            "range": [
              "#187d89",
              "#e7a078",
              "#55a6a2",
              "#9a94c5",
              "#ba728d"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "columns": 5
          }
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Reserve"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Dedicated"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.name == 'Maroubra' || datum.name == 'Norah Head' || datum.name == 'Margaret River'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -15,
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#0e5662"
      },
      "encoding": {
        "x": {
          "field": "dedication_position",
          "type": "quantitative"
        },
        "y": {
          "field": "state",
          "type": "nominal"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "transform": [
    {
      "calculate": "datum.year + (datum.month - 1) / 12",
      "as": "dedication_position"
    }
  ]
}
