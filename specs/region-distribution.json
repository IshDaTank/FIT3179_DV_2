{
  "background": null,
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#58727b",
      "titleColor": "#47656c",
      "gridColor": "#e8eeee",
      "domain": false,
      "tickColor": "#dbe5e4",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#59757c",
      "titleColor": "#486c73"
    },
    "text": {
      "font": "DM Sans"
    },
    "range": {
      "category": [
        "#187d89",
        "#e7a078",
        "#55a6a2",
        "#9a94c5",
        "#ba728d"
      ]
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "height": 340,
  "data": {
    "url": "data/reserves.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "sites"
        },
        {
          "op": "min",
          "field": "year",
          "as": "first"
        }
      ],
      "groupby": [
        "state",
        "region"
      ]
    },
    {
      "calculate": "datum.state + \" — \" + datum.region",
      "as": "coast"
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#b5d4d2",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "coast",
          "type": "nominal",
          "sort": {
            "field": "sites",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 235,
            "labelFontSize": 11
          }
        },
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "sites"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "stroke": "white",
        "strokeWidth": 1.4
      },
      "encoding": {
        "y": {
          "field": "coast",
          "type": "nominal",
          "sort": {
            "field": "sites",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 235,
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "sites",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              5.5
            ]
          },
          "axis": {
            "title": "Listed reserves",
            "tickMinStep": 1,
            "grid": true
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "WA",
              "QLD",
              "SA",
              "VIC"
            ],
            "range": [
              "#187d89",
              "#e7a078",
              "#55a6a2",
              "#9a94c5",
              "#ba728d"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "columns": 5
          }
        },
        "tooltip": [
          {
            "field": "coast",
            "title": "Coastal region"
          },
          {
            "field": "sites",
            "title": "Reserves"
          },
          {
            "field": "first",
            "title": "Earliest dedication"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dx": 12,
        "align": "left",
        "fontWeight": "bold",
        "fontSize": 11,
        "color": "#224b55"
      },
      "encoding": {
        "y": {
          "field": "coast",
          "type": "nominal",
          "sort": {
            "field": "sites",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 235,
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "sites",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              5.5
            ]
          },
          "axis": {
            "title": "Listed reserves",
            "tickMinStep": 1,
            "grid": true
          }
        },
        "text": {
          "field": "sites",
          "type": "quantitative"
        }
      }
    }
  ]
}
